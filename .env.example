# ==============================================================================
# AJPR World - Environment Variable Configuration Template
# Placeholders only. NEVER commit real credentials or production secrets.
# ==============================================================================

# Application Base URL (Used for strict CSRF & Origin validation in Route Handlers)
# NOTE: Vercel preview deployments will fail assertSameOrigin() checks unless
# NEXT_PUBLIC_BASE_URL is dynamically updated or configured to the preview URL.
NEXT_PUBLIC_BASE_URL=https://example.com

# Admin Access Control (Comma-separated list of authorized admin emails)
# Fail-closed: If unset or empty, no user is granted admin permissions.
ADMIN_EMAILS=admin@example.com,security@example.com

# Authentication & Security
# Cryptographically secure random secret, at least 32 characters long
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_chars
CRON_SECRET=replace_with_a_secure_cron_bearer_token

# Database Connection
DATABASE_URL=postgresql://user:password@db.example.com:5432/dbname?sslmode=require

# External Service Integrations (Placeholders)
GOOGLE_CLIENT_ID=example-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-client-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example_placeholder


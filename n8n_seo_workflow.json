    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert content humanizer. Your job is to make AI-written content sound completely human.\n\nHere is the blog post:\n{{ $json.output }}\n\nYour task:\nRewrite the entire blog post to sound like it was written by a real expert human author.\n\nSpecific instructions:\n- Vary sentence length dramatically — short punchy sentences followed by longer explanatory ones\n- Use natural transitions between paragraphs instead of mechanical ones\n- Add occasional first-person observations where natural (\"In my experience...\", \"What I find interesting is...\")\n- Use contractions naturally (don't, it's, you'll, we've)\n- Replace any passive voice with active voice wherever possible\n- Remove any phrases that sound AI-generated: \"In today's fast-paced world\", \"It is worth noting\", \"Furthermore\", \"Moreover\", \"It is crucial to\", \"In conclusion\"\n- Add a touch of personality and opinion in appropriate places\n- Keep every SEO keyword exactly as written — do not change keywords\n- Keep all headings, structure, FAQ, and CTA exactly as they are\n- Keep the full word count — do not shorten the post\n\nReturn the complete humanized blog post.",
        "options": {}
      },
      "id": "b30cf88c-7f55-46f9-bb20-2b10214a6de0",
      "name": "Humanizer Agent",
      "type": "n8n-nodes-base.advancedAgent",
      "typeVersion": 2,
      "position": [
        3920,
        -120
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "id": "b30cf88c-7f55-46f9-bb20-2b10214a6ddf",
      "name": "OpenAI Chat Model (GPT-4o, Humanizer)",
      "type": "n8n-nodes-base.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        3920,
        40
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior SEO auditor performing a final quality check before publication.\n\nHere is the blog post:\n{{ $json.output }}\n\nPerform a complete audit and fix any issues found:\n\nChecklist:\n1. Title (H1) — is it under 60 characters? Does it contain the primary keyword? Fix if not.\n2. Meta description — is it under 160 characters? Does it have a call to action? Fix if not.\n3. Introduction — does it hook the reader and contain the primary keyword in the first 100 words? Fix if not.\n4. Headings — are H2s and H3s using keywords naturally? Fix weak headings.\n5. FAQ — are all 5 questions answered directly and concisely? Fix vague answers.\n6. CTA — is the call to action specific and compelling? Fix if generic.\n7. Word count — is it at least 1500 words? If the post is too short, expand the thinnest section.\n8. Readability — are there any paragraphs longer than 5 sentences? Break them up.\n\nReturn the final, publication-ready blog post with all issues fixed.\nDo not add any commentary or audit notes — return only the clean blog post.",
        "options": {}
      },
      "id": "b30cf88c-7f55-46f9-bb20-2b10214a6de2",
      "name": "Final SEO Audit Pass",
      "type": "n8n-nodes-base.advancedAgent",
      "typeVersion": 2,
      "position": [
        4170,
        -120
      ]
    },

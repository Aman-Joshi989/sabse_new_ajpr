          "string": [
            {
              "value1": "={{ $json.output }}",
              "operation": "contains",
              "value2": "recommendedPrimaryKeyword"
            }
          ]
        }
      },
      "id": "b30cf88c-7f55-46f9-bb20-2b10214a6dd6",
      "name": "Keyword Quality Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2450,
        -20

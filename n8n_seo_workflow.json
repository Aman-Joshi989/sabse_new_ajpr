    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data visualization specialist.\n\nHere is a blog post:\n{{ $json.output }}\n\nExtract the most visually interesting data points from this blog post for use in an infographic or featured image.\n\nReturn a JSON object:\n{\n  \"blogTitle\": \"\",\n  \"mainTopic\": \"\",\n  \"keyStats\": [],\n  \"topTakeaways\": [],\n  \"visualTheme\": \"\",\n  \"colorMoodSuggestion\": \"\"\n}\n\nKeep it concise. This will be used to generate an AI image prompt.",
        "options": {}

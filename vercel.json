{
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://ajprworld.com/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ajprworld.com"
        }
      ],
      "statusCode": 301
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-blog",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/generate-post",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/sales-outreach",
      "schedule": "0 14 * * *"
    }
  ]
}
